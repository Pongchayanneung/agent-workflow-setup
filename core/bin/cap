#!/usr/bin/env bash
# cap - capability registry: search BEFORE building a new script/tool/hook.
#   cap <words...>   search (AND across words)
#   cap --all        list everything
#   cap --render     regenerate ~/.agent-workflow/CAPABILITIES.md from the TSV (never hand-edit the .md)
#   cap --scan       drift: registered-but-missing paths
# Source of truth: ~/.agent-workflow/capabilities.tsv  (group<TAB>what<TAB>host<TAB>path<TAB>how to run)
set -uo pipefail
TSV="${CAP_TSV:-${AGENT_WORKFLOW_HOME:-$HOME/.agent-workflow}/capabilities.tsv}"
MD="${CAP_MD:-${AGENT_WORKFLOW_HOME:-$HOME/.agent-workflow}/CAPABILITIES.md}"
[ -f "$TSV" ] || { echo "cap: registry not found: $TSV" >&2; exit 1; }

rows() { grep -v '^[[:space:]]*#' "$TSV" | grep -v '^[[:space:]]*$'; }
fmt() { awk -F'\t' '{printf "\033[1m%s\033[0m  (%s)\n  where: %s:%s\n", $2,$1,$3,$4; if ($5!="") printf "  run:   %s\n",$5; print ""}'; }

case "${1:---all}" in
  --all) rows | fmt ;;
  --render)
    { echo "# CAPABILITIES - what already exists, so it does not get rebuilt"
      echo; echo "GENERATED by \`cap --render\`. Edit capabilities.tsv instead."; echo
      rows | cut -f1 | sort -u | while IFS= read -r g; do
        printf '## %s\n\n| what | host | path | run |\n|---|---|---|---|\n' "$g"
        rows | awk -F'\t' -v g="$g" '$1==g {printf "| %s | %s | `%s` | `%s` |\n",$2,$3,$4,$5}'; echo
      done; } > "$MD" && echo "cap: wrote $MD ($(rows | wc -l | tr -d ' ') entries)" ;;
  --scan)
    miss=0
    while IFS=$'\t' read -r _g what host path _h; do
      [ "$host" = "local" ] || continue
      [ -e "${path/#\~/$HOME}" ] || { echo "MISSING  $path  ($what)"; miss=$((miss+1)); }
    done < <(rows)
    echo "drift: $miss missing"; [ "$miss" -eq 0 ] ;;
  -h|--help) sed -n '2,7p' "$0" ;;
  *) out=$(rows)
     for w in "$@"; do out=$(printf '%s\n' "$out" | grep -iF -- "$w") || { echo "cap: nothing matches \"$*\""; exit 1; }; done
     printf '%s\n' "$out" | fmt ;;
esac
