#!/usr/bin/env python3
"""Log which model/effort/route handled a task and whether it passed, then compare routes.

  routelog add --task "<your task>" --route direct --model "<your model>" --effort medium \
               --result pass --minutes 3 --retries 0 [--note "..."]
  routelog summary [--since <your date>]

Log: ~/.agent-workflow/route-log.jsonl (override with ROUTELOG_PATH). Append-only, stdlib only.
Measures YOUR tasks. Do not quote numbers from social posts as if they were this data.
No cost column; add measured billing data by hand in --note if needed.
"""
import argparse
import collections
import datetime as dt
import json
import os
import sys
from pathlib import Path

LOG = Path(os.environ.get("ROUTELOG_PATH", Path.home() / ".agent-workflow/route-log.jsonl"))
RESULTS = ("pass", "fail", "partial")


def add(a):
    row = {"ts": dt.datetime.now().astimezone().isoformat(timespec="seconds"), "task": a.task,
           "route": a.route, "model": a.model, "effort": a.effort, "result": a.result,
           "minutes": a.minutes, "retries": a.retries, "note": a.note}
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    print(f"logged ({LOG})")


def rows(since):
    if not LOG.exists():
        return []
    out = [json.loads(line) for line in LOG.read_text(encoding="utf-8").splitlines() if line.strip()]
    return [r for r in out if not since or r["ts"][:10] >= since]


def summary(a):
    data = rows(a.since)
    if not data:
        print("no rows yet")
        return
    groups = collections.defaultdict(list)
    for r in data:
        groups[(r["route"], r["model"], r["effort"])].append(r)
    print(f"{'route':<14}{'model':<10}{'effort':<8}{'n':>3} {'pass%':>6} {'min':>6} {'retry':>6}")
    for (route, model, effort), g in sorted(groups.items()):
        n = len(g)
        ok = sum(r["result"] == "pass" for r in g) / n * 100
        mins = sum(r["minutes"] for r in g) / n
        ret = sum(r["retries"] for r in g) / n
        flag = "  (n<5, too few to compare)" if n < 5 else ""
        print(f"{route:<14}{model:<10}{effort:<8}{n:>3} {ok:>5.0f}% {mins:>6.1f} {ret:>6.1f}{flag}")


def selftest():
    global LOG
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        LOG = Path(d) / "log.jsonl"
        p = build()
        for res, mins in (("pass", 2), ("fail", 8), ("pass", 4)):
            add(p.parse_args(["add", "--task", "t", "--route", "direct", "--model", "sonnet",
                              "--effort", "medium", "--result", res, "--minutes", str(mins)]))
        data = rows(None)
        assert len(data) == 3 and sum(r["result"] == "pass" for r in data) == 2
        summary(p.parse_args(["summary"]))
    print("ok")


def build():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("add")
    s.add_argument("--task", required=True)
    s.add_argument("--route", required=True, help="e.g. direct, subagent, agy, codex")
    s.add_argument("--model", required=True)
    s.add_argument("--effort", default="medium")
    s.add_argument("--result", required=True, choices=RESULTS)
    s.add_argument("--minutes", type=float, required=True)
    s.add_argument("--retries", type=int, default=0)
    s.add_argument("--note", default="")
    s.set_defaults(fn=add)
    m = sub.add_parser("summary")
    m.add_argument("--since")
    m.set_defaults(fn=summary)
    return p


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    else:
        a = build().parse_args()
        a.fn(a)
